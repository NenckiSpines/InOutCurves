    "P_VALUES_WITHOUT_DIFFERENCES_DUMP_FILE_NAME=\"dump/p_values_without_differences.pkl\"\n",
    "p_values_without_differences = []\n",
    "if exists(P_VALUES_WITHOUT_DIFFERENCES_DUMP_FILE_NAME):\n",
    "    with open(P_VALUES_WITHOUT_DIFFERENCES_DUMP_FILE_NAME, \"rb\") as file:\n",
    "        p_values_without_differences = load(file)\n",
    "else:\n",
    "    for _ in range(1000):\n",
    "        fake = animal_results.to_fake()\n",
    "        grouped_by_animal = fake.group_by_animal()\n",
    "        grouped_by_group = grouped_by_animal.group_by_group()\n",
    "        l2 = grouped_by_group.get_l2()\n",
    "        randomized_group_l2s = [grouped_by_animal.randomize_groups().group_by_group().get_l2() for _ in range(2000)]\n",
    "        p_values_without_differences.append(get_p_value(randomized_group_l2s, l2))\n",
    "        with open(P_VALUES_WITHOUT_DIFFERENCES_DUMP_FILE_NAME, \"wb\") as file:\n",
    "            dump(p_values_without_differences, file)\n",
    "P_VALUES_WITH_DIFFERENCES_DUMP_FILE_NAME=\"dump/p_values_with_differences.pkl\"\n",
